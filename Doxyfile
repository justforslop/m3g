# Doxyfile for m3g — public API documentation
# Generate: make doc   (or: doxygen Doxyfile)

PROJECT_NAME           = m3g
PROJECT_BRIEF          = "JSR-184 / M3G decode (C99 m3g.h) and glTF convert (C++17 m3g.hpp)"
PROJECT_NUMBER         =

OUTPUT_DIRECTORY       = docs/api
CREATE_SUBDIRS         = NO

# Public APIs: C single-header + C++ amalgamated header.
INPUT                  = include/m3g.h include/m3g.hpp
FILE_PATTERNS          = *.hpp *.h
RECURSIVE              = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO

# Do NOT predefine M3G_HPP_INCLUDED / m3g_h — that empties the headers.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
# Never define M3G_DECODE_IMPL / M3G_IMPL here: #ifdef would still be true if
# the macro exists (even empty), and the implementation section would be parsed.
PREDEFINED             = __cplusplus=201703L \
                         M3G_DECODE_API_DECL= \
                         M3G_API_DECL= \
                         M3G_API_IMPL= \
                         M3G_API= \
                         DOXYGEN=1
SKIP_FUNCTION_MACROS   = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = docs/api/doxygen.warn

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES

HAVE_DOT               = NO

JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = NO
MARKDOWN_SUPPORT       = YES

TAB_SIZE               = 4
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO

STRIP_FROM_PATH        = ./
STRIP_FROM_INC_PATH    = include/

# Show modules (@defgroup) in the nav tree.
GENERATE_TODOLIST      = NO
SHOW_NAMESPACES        = YES

EXCLUDE_SYMBOLS        =
