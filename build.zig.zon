.{
    // Package key for `zig fetch --save` / `b.dependency("m3g", …)`.
    .name = .m3g,
    // Matches M3G_VERSION_* in include/m3g.h and CMake project version.
    .version = "0.1.0",
    // Generated by the Zig toolchain; do not change casually (trust / identity).
    .fingerprint = 0x98f310aab3d0e7de,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{},
    // Files included in the package hash and in `zig fetch` checkouts.
    // Vendored third parties under vendors/ must be present (run `zig build setup`
    // before packaging or using a path dependency). Viewer-only deps (imgui,
    // sokol) are not required to link artifact "m3g".
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "include",
        "src",
        "vendors",
        "README.md",
        "BUILD.md",
    },
}
