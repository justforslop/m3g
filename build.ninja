# m3g — M3G decoder / glTF converter (C++17)
# Single-file Ninja build (Linux + Windows/MinGW). No conf.ninja / configure.
#
# Build:
#   ninja            # viewer -> build/debug[$exe]  (sokol)
#   ninja debug      # same
#   ninja view       # same as debug
#   ninja release    # CLI    -> build/m3g[$exe]
#   ninja -t clean
#
# Viewer:
#   ./build/debug assets/90.m3g          # Linux
#   build\debug.exe assets\90.m3g        # Windows (after win overrides)
#
# Vendored headers:  ninja setup
# Tests:             ninja test
#                    n=1,2 s=10 ninja test   (cmd: set n=1&& ninja test)
#
# Object files under build/obj/<config>/ so build/debug can be the binary.
#
# --- Platform ---
# Defaults below are Linux. Ninja has no if/OS, so on Windows/MinGW either:
#   1) Uncomment the "Windows MinGW overrides" block, OR
#   2) Pass on the CLI, e.g.:
#        ninja release exe=.exe cxx=g++ view_libs="-lm -lopengl32 -lgdi32" posix_cppflags= py=python
#
# Setup/test recipes use Python scripts (OS-portable). Needs python3 (or py=python).

ninja_required_version = 1.5

# ---------------------------------------------------------------------------
# Toolchain / platform (Linux defaults)
# ---------------------------------------------------------------------------

exe =
cxx = c++
cc = gcc
test_cc = gcc
py = python3

app = m3g
buildroot = build
srcdir = src
incdir = include
test_bindir = tests/bin

app_libs = -lm
# Sokol GLCORE viewer — Linux X11
view_libs = $app_libs -lGL -lX11 -lXi -lXcursor -ldl -lpthread
# glibc/musl feature macros for vendored C
posix_cppflags = -D_DEFAULT_SOURCE

# --- Windows MinGW overrides (uncomment all lines in this block) ---
# exe = .exe
# cxx = g++
# cc = gcc
# test_cc = gcc
# py = python
# app_libs = -lm
# view_libs = $app_libs -lopengl32 -lgdi32
# posix_cppflags =

miniz_tag = 3.1.2
miniz_url = https://github.com/richgel999/miniz/releases/download/${miniz_tag}/miniz-${miniz_tag}.zip
miniz_archive = ${buildroot}/miniz-${miniz_tag}.zip
miniz_dir = vendors/miniz
miniz_stamp = ${miniz_dir}/.extracted

imgui_tag = 1.92.9b
imgui_url = https://github.com/ocornut/imgui/archive/refs/tags/v${imgui_tag}.zip
imgui_archive = ${buildroot}/imgui-${imgui_tag}.zip
imgui_dir = vendors/imgui
imgui_stamp = ${imgui_dir}/.extracted

app_cppflags = -I. -I${incdir} -I${srcdir} -Ivendors -Ivendors/cgltf -Ivendors/libs -Ivendors/miniz
view_cppflags = $app_cppflags -Ivendors/imgui
app_ldflags =

cxxflags_debug = -std=c++17 -Wall -Wextra -O0 -g $posix_cppflags -DAPP_NAME=\"${app}\"
cxxflags_release = -std=c++17 -Wall -Wextra -Os -g0 -DNDEBUG $posix_cppflags -DAPP_NAME=\"${app}\"
cflags_debug = -std=c99 -Wall -Wextra -O0 -g $posix_cppflags
cflags_release = -std=c99 -Wall -Wextra -Os -g0 -DNDEBUG $posix_cppflags

# ---------------------------------------------------------------------------
# rules
# ---------------------------------------------------------------------------

rule cxx_debug
  command = $cxx $cxxflags_debug $app_cppflags -c -o $out $in
  description = CXX(debug) $in

rule cxx_release
  command = $cxx $cxxflags_release $app_cppflags -c -o $out $in
  description = CXX(release) $in

rule cc_debug
  command = $cc $cflags_debug $app_cppflags -c -o $out $in
  description = CC(debug) $in

rule cc_release
  command = $cc $cflags_release $app_cppflags -c -o $out $in
  description = CC(release) $in

rule cxx_view_debug
  command = $cxx $cxxflags_debug $view_cppflags -x c++ -c -o $out $in
  description = CXX(viewer) $in

rule cxx_imgui_debug
  command = $cxx $cxxflags_debug $view_cppflags -c -o $out $in
  description = CXX(imgui) $in

rule link_debug
  command = $cxx $cxxflags_debug -o $out $in $app_ldflags $view_libs
  description = LD $out

rule link_release
  command = $cxx $cxxflags_release -o $out $in $app_ldflags $app_libs
  description = LD $out

rule curl_stamp
  command = $py scripts/curl_stamp.py $url $dest $out
  description = CURL $dest
  restat = 1
  pool = console

rule curl_zip
  command = $py scripts/curl_zip.py $url $out
  description = CURL $out
  pool = console

rule extract_miniz
  command = $py scripts/extract_vendor.py miniz $in ${miniz_dir} $out
  description = EXTRACT miniz
  restat = 1

rule extract_imgui
  command = $py scripts/extract_vendor.py imgui $in ${imgui_dir} ${imgui_tag} $out
  description = EXTRACT imgui
  restat = 1

rule run_tests
  command = $py scripts/run_tests.py
  description = TEST
  pool = console

rule doxygen
  command = $py -c "import shutil,sys,os,subprocess; shutil.which('doxygen') or sys.exit('doxygen not found'); os.makedirs('docs/api', exist_ok=True); subprocess.check_call(['doxygen', sys.argv[1]]); print('Open docs/api/html/index.html')" $in
  description = DOXYGEN $in
  pool = console

# ---------------------------------------------------------------------------
# sources → objects (debug + release)
# ---------------------------------------------------------------------------

# --- debug objects ---
build build/obj/debug/converter.o: cxx_debug src/converter.cpp
build build/obj/debug/decode/decoder.o: cxx_debug src/decode/decoder.cpp
build build/obj/debug/deflate_io_miniz.o: cxx_debug src/deflate_io_miniz.cpp
build build/obj/debug/image_io_stb.o: cxx_debug src/image_io_stb.cpp
build build/obj/debug/json_io_cjson.o: cxx_debug src/json_io_cjson.cpp
build build/obj/debug/gltf_io_cgltf.o: cxx_debug src/gltf_io_cgltf.cpp
build build/obj/debug/export/gltf_exporter.o: cxx_debug src/export/gltf_exporter.cpp
build build/obj/debug/gltf/gltf_writer.o: cxx_debug src/gltf/gltf_writer.cpp
build build/obj/debug/main.o: cxx_debug src/main.cpp
build build/obj/debug/util/png_writer.o: cxx_debug src/util/png_writer.cpp
build build/obj/debug/impl.o: cc_debug src/impl.c
build build/obj/debug/vendors/cjson/cJSON.o: cc_debug vendors/cjson/cJSON.c
build build/obj/debug/vendors/miniz/miniz.o: cc_debug vendors/miniz/miniz.c

build build/obj/debug/debug_view.o: cxx_view_debug src/debug.c

build build/obj/debug/imgui/imgui.o: cxx_imgui_debug vendors/imgui/imgui.cpp
build build/obj/debug/imgui/imgui_draw.o: cxx_imgui_debug vendors/imgui/imgui_draw.cpp
build build/obj/debug/imgui/imgui_tables.o: cxx_imgui_debug vendors/imgui/imgui_tables.cpp
build build/obj/debug/imgui/imgui_widgets.o: cxx_imgui_debug vendors/imgui/imgui_widgets.cpp

build build/debug${exe}: link_debug $
    build/obj/debug/converter.o $
    build/obj/debug/decode/decoder.o $
    build/obj/debug/deflate_io_miniz.o $
    build/obj/debug/image_io_stb.o $
    build/obj/debug/json_io_cjson.o $
    build/obj/debug/gltf_io_cgltf.o $
    build/obj/debug/export/gltf_exporter.o $
    build/obj/debug/gltf/gltf_writer.o $
    build/obj/debug/util/png_writer.o $
    build/obj/debug/impl.o $
    build/obj/debug/vendors/cjson/cJSON.o $
    build/obj/debug/vendors/miniz/miniz.o $
    build/obj/debug/debug_view.o $
    build/obj/debug/imgui/imgui.o $
    build/obj/debug/imgui/imgui_draw.o $
    build/obj/debug/imgui/imgui_tables.o $
    build/obj/debug/imgui/imgui_widgets.o

# --- release objects ---
build build/obj/release/converter.o: cxx_release src/converter.cpp
build build/obj/release/decode/decoder.o: cxx_release src/decode/decoder.cpp
build build/obj/release/deflate_io_miniz.o: cxx_release src/deflate_io_miniz.cpp
build build/obj/release/image_io_stb.o: cxx_release src/image_io_stb.cpp
build build/obj/release/json_io_cjson.o: cxx_release src/json_io_cjson.cpp
build build/obj/release/gltf_io_cgltf.o: cxx_release src/gltf_io_cgltf.cpp
build build/obj/release/export/gltf_exporter.o: cxx_release src/export/gltf_exporter.cpp
build build/obj/release/gltf/gltf_writer.o: cxx_release src/gltf/gltf_writer.cpp
build build/obj/release/main.o: cxx_release src/main.cpp
build build/obj/release/util/png_writer.o: cxx_release src/util/png_writer.cpp
build build/obj/release/impl.o: cc_release src/impl.c
build build/obj/release/vendors/cjson/cJSON.o: cc_release vendors/cjson/cJSON.c
build build/obj/release/vendors/miniz/miniz.o: cc_release vendors/miniz/miniz.c

build build/m3g${exe}: link_release $
    build/obj/release/converter.o $
    build/obj/release/decode/decoder.o $
    build/obj/release/deflate_io_miniz.o $
    build/obj/release/image_io_stb.o $
    build/obj/release/json_io_cjson.o $
    build/obj/release/gltf_io_cgltf.o $
    build/obj/release/export/gltf_exporter.o $
    build/obj/release/gltf/gltf_writer.o $
    build/obj/release/main.o $
    build/obj/release/util/png_writer.o $
    build/obj/release/impl.o $
    build/obj/release/vendors/cjson/cJSON.o $
    build/obj/release/vendors/miniz/miniz.o

# ---------------------------------------------------------------------------
# phony aliases
# ---------------------------------------------------------------------------

build all debug view: phony build/debug${exe}
build release: phony build/m3g${exe}

default all

# ---------------------------------------------------------------------------
# setup (vendor downloads) — stamps under build/setup/; run: ninja setup
# ---------------------------------------------------------------------------

build build/setup/libs-testfw.h: curl_stamp
  dest = vendors/libs/testfw.h
  url = https://raw.githubusercontent.com/mattiasgustavsson/libs/refs/heads/main/testfw.h

build setup-libs: phony build/setup/libs-testfw.h

build build/setup/cgltf.h: curl_stamp
  dest = vendors/cgltf/cgltf.h
  url = https://raw.githubusercontent.com/jkuhlmann/cgltf/refs/heads/master/cgltf.h

build build/setup/cgltf_write.h: curl_stamp
  dest = vendors/cgltf/cgltf_write.h
  url = https://raw.githubusercontent.com/jkuhlmann/cgltf/refs/heads/master/cgltf_write.h

build setup-cgltf: phony build/setup/cgltf.h build/setup/cgltf_write.h

build build/setup/cJSON.c: curl_stamp
  dest = vendors/cjson/cJSON.c
  url = https://raw.githubusercontent.com/DaveGamble/cJSON/refs/heads/master/cJSON.c

build build/setup/cJSON.h: curl_stamp
  dest = vendors/cjson/cJSON.h
  url = https://raw.githubusercontent.com/DaveGamble/cJSON/refs/heads/master/cJSON.h

build setup-cjson: phony build/setup/cJSON.c build/setup/cJSON.h

build build/setup/stb_image.h: curl_stamp
  dest = vendors/stb/stb_image.h
  url = https://raw.githubusercontent.com/nothings/stb/refs/heads/master/stb_image.h

build build/setup/stb_image_write.h: curl_stamp
  dest = vendors/stb/stb_image_write.h
  url = https://raw.githubusercontent.com/nothings/stb/refs/heads/master/stb_image_write.h

build setup-stb: phony build/setup/stb_image.h build/setup/stb_image_write.h

# Only headers used by src/debug.c (viewer).
build build/setup/sokol_app.h: curl_stamp
  dest = vendors/sokol/sokol_app.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/sokol_app.h
build build/setup/sokol_gfx.h: curl_stamp
  dest = vendors/sokol/sokol_gfx.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/sokol_gfx.h
build build/setup/sokol_glue.h: curl_stamp
  dest = vendors/sokol/sokol_glue.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/sokol_glue.h
build build/setup/sokol_log.h: curl_stamp
  dest = vendors/sokol/sokol_log.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/sokol_log.h
build build/setup/sokol_time.h: curl_stamp
  dest = vendors/sokol/sokol_time.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/sokol_time.h
build build/setup/sokol_gl.h: curl_stamp
  dest = vendors/sokol/util/sokol_gl.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/util/sokol_gl.h
build build/setup/sokol_imgui.h: curl_stamp
  dest = vendors/sokol/util/sokol_imgui.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/util/sokol_imgui.h
build build/setup/sokol_gfx_imgui.h: curl_stamp
  dest = vendors/sokol/util/sokol_gfx_imgui.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/util/sokol_gfx_imgui.h
build build/setup/sokol_app_imgui.h: curl_stamp
  dest = vendors/sokol/util/sokol_app_imgui.h
  url = https://raw.githubusercontent.com/floooh/sokol/refs/heads/master/util/sokol_app_imgui.h

build setup-sokol: phony $
    build/setup/sokol_app.h build/setup/sokol_gfx.h build/setup/sokol_glue.h $
    build/setup/sokol_log.h build/setup/sokol_time.h build/setup/sokol_gl.h $
    build/setup/sokol_imgui.h build/setup/sokol_gfx_imgui.h build/setup/sokol_app_imgui.h

build ${miniz_archive}: curl_zip
  url = ${miniz_url}

build ${miniz_stamp}: extract_miniz ${miniz_archive}
build setup-miniz: phony ${miniz_stamp}

build ${imgui_archive}: curl_zip
  url = ${imgui_url}

build ${imgui_stamp}: extract_imgui ${imgui_archive}
build setup-imgui: phony ${imgui_stamp}

build setup: phony setup-cgltf setup-cjson setup-stb setup-sokol setup-libs setup-miniz setup-imgui

# ---------------------------------------------------------------------------
# docs (doxygen)
# ---------------------------------------------------------------------------

build docs/api/html/index.html: doxygen Doxyfile | include/m3g.hpp include/m3g.h
build doc: phony docs/api/html/index.html

# ---------------------------------------------------------------------------
# tests
# ---------------------------------------------------------------------------

build test: run_tests
  pool = console

# ---------------------------------------------------------------------------
# clean: ninja -t clean
# full wipe: rm -rf build tests/bin   |   rmdir /s /q build tests\bin
# ---------------------------------------------------------------------------
